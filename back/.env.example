# Local development (no Docker). The Docker stack gets its settings from the root .env.example.
KIDSUP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kidsup
KIDSUP_CORS_ORIGINS=["http://localhost:5173"]

# Production only, for the one-off `python -m app.bootstrap` job (never give these to the API):
# KIDSUP_ADMIN_DATABASE_URL=postgresql://<superuser>:<password>@<host>:5432/<database>
# KIDSUP_MIGRATION_DATABASE_URL=postgresql://kidsup_owner:<password>@<host>:5432/<database>
# and KIDSUP_DATABASE_URL then names the limited account: postgresql://kidsup_app:<password>@<host>:5432/<database>

# Days an application that never led to enrolment is kept (30 to 3650).
# KIDSUP_RETENTION_DAYS=365
