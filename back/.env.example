# Local development (no Docker). The Docker stack gets its settings from the root .env.example.
KIDSUP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kidsup
KIDSUP_CORS_ORIGINS=["http://localhost:5173"]

# Production only, for the one-off `python -m app.bootstrap` job (never give these to the API):
# KIDSUP_ADMIN_DATABASE_URL=postgresql://<superuser>:<password>@<host>:5432/<database>?sslmode=verify-full
# KIDSUP_MIGRATION_DATABASE_URL=postgresql://kidsup_owner:<password>@<host>:5432/<database>?sslmode=verify-full
# KIDSUP_RETENTION_DATABASE_URL=postgresql://kidsup_retention:<password>@<host>:5432/<database>?sslmode=verify-full
# and KIDSUP_DATABASE_URL then names the API's account, which can only add applications:
#   postgresql://kidsup_app:<password>@<host>:5432/<database>?sslmode=verify-full
# The four accounts must be different roles with different passwords of at least 24 characters, on the same server and
# database. `postgres` and `pg_*` are refused as role names.

# Days an application that never led to enrolment is kept (30 to 365: the privacy notice promises 12 months).
# KIDSUP_RETENTION_DAYS=365
