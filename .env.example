# Copy to .env (never commit .env). Used by docker-compose.yml.

# Database password. Use letters and digits only (it is embedded in a URL), at least 24 characters, e.g.:
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# Where the site is exposed on the host. Keep 127.0.0.1 unless a firewall/TLS proxy is in front.
FRONT_BIND=127.0.0.1
FRONT_PORT=8080
