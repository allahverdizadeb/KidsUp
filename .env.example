# Copy to .env (never commit .env, and keep it out of folders that sync to a cloud drive). Used by docker-compose.yml.

# Five database passwords, all different. Use letters and digits only (they are embedded in database URLs), at
# least 24 characters (the bootstrap job refuses anything shorter or repeated), e.g.:
#   python -c "import secrets; print(secrets.token_hex(24))"
# The PostgreSQL superuser: only the one-off bootstrap job and the operator use it, never the API.
# (It is applied only when the database is first created; to change it later, see "Rotating a password" in docs/docker.md.)
POSTGRES_PASSWORD=
# Owns the tables and runs the migrations: only the bootstrap job uses it.
POSTGRES_OWNER_PASSWORD=
# What the API connects as: it can add an application and nothing else.
POSTGRES_APP_PASSWORD=
# What the retention job and the operator's commands connect as: find and delete applications.
POSTGRES_RETENTION_PASSWORD=
# What the admin panel connects as: it reads and changes what staff work with (applications, courses, the landing
# page's texts, accounts, the audit log), and nothing else.
POSTGRES_PANEL_PASSWORD=

# The key that encrypts the admin accounts' one-time-code secrets in the database (a Fernet key: 32 random bytes,
# URL-safe base64), e.g.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it locks every staff member out until their authenticator is set up again (reset-second-factor); changing it
# does the same. Keep a copy somewhere safe that is not this folder.
PANEL_SECRET_KEY=

# Where the site is exposed on the host. Keep 127.0.0.1 unless a firewall/TLS proxy is in front.
FRONT_BIND=127.0.0.1
FRONT_PORT=8080

# Where the admin panel is exposed on the host. Keep 127.0.0.1: put a TLS-terminating proxy and a network allow-list
# (VPN or office addresses) in front before it is reachable by anyone else (docs/docker.md).
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8081
# Optional. The origins the admin panel's pages are served from, as a JSON list: a state-changing request from any other
# origin is refused. Change it together with ADMIN_PORT or the public address of the admin panel.
# ADMIN_ORIGINS=["http://127.0.0.1:8081","http://localhost:8081"]

# Optional. The private range between nginx and the API (the API believes X-Forwarded-For only from it).
# Change it only if it clashes with another network on the machine.
# APP_SUBNET=172.29.250.0/28
# Optional. The same for the admin nginx and the panel (must not overlap APP_SUBNET).
# ADMIN_SUBNET=172.29.250.16/28

# Optional. Days an application that was not approved is kept (30 to 365: the privacy notice promises 12 months).
# RETENTION_DAYS=365
